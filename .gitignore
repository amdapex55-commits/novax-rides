# Dependencies (this app ships as static files; npx is used for tooling)
node_modules/

# Build output of scripts/deploy-public.js
public/

# Capacitor native projects — regenerated by `npx cap add`
android/
# Capacitor build output. Rebuilt from scratch by scripts/select-app.js on
# every build, and it holds whichever app was built last — committing it
# would put one app's assets in the repo under a name that says nothing
# about which.
www/
ios/

# Secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log

# NOTE: vendor/ and fonts/ are deliberately COMMITTED. They are the
# self-hosted socket.io client and woff2 files — the whole point is that a
# deploy doesn't depend on a CDN being reachable.

# Mapbox token — public, but kept out of git (see js/map-token.example.js)
js/map-token.js

# Build output of scripts/deploy-public.js
public/
.claude/

# macOS / Forklift / editor atomic-write leftovers. A 0-byte
# .!31929!launch.config.js was committed once and kept reappearing in builds.
# Ignored as a class so the next one never gets staged.
.!*
.DS_Store
*.swp
*~
