# Dependencies (this app ships as static files; npx is used for tooling)
node_modules/

# Build output of scripts/deploy-public.js
public/

# Capacitor native projects — regenerated by `npx cap add`
android/
ios/

# Secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log

# NOTE: vendor/ and fonts/ are deliberately COMMITTED. They are the
# self-hosted socket.io client and woff2 files — the whole point is that a
# deploy doesn't depend on a CDN being reachable.
