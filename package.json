{
  "name": "novax-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Nova X \u2014 one codebase, four apps (customer / driver / merchant / ops).",
  "scripts": {
    "serve": "npx http-server . -p 8100 -c-1",
    "app:customer": "node scripts/select-app.js customer",
    "app:driver": "node scripts/select-app.js driver",
    "app:merchant": "node scripts/select-app.js merchant",
    "app:ops": "node scripts/select-app.js ops",
    "cap:sync:customer": "npm run app:customer && npx cap sync",
    "cap:sync:driver": "npm run app:driver && npx cap sync",
    "cap:sync:merchant": "npm run app:merchant && npx cap sync",
    "cap:sync:ops": "npm run app:ops && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "app:web": "node scripts/select-app.js web"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/ios": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "http-server": "^14.1.1"
  }
}
